---
// src/layouts/LegalLayout.astro
// Shared wrapper for /privacy, /terms, /accessibility — Section 6 of the
// build spec. Adds a visible breadcrumb and BreadcrumbList JSON-LD
// (Section 7: "Consider BreadcrumbList if legal pages are indexed
// separately") on top of the base Layout.

import Layout from "./Layout.astro";
import siteConfig from "../data/site-config.js";

interface Props {
  title: string;
  pageName: string;
  description?: string;
  updatedDate?: string;
}

const { title, pageName, description, updatedDate = "Not yet finalized" } = Astro.props;

const canonicalPath = Astro.url.pathname;
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    {
      "@type": "ListItem",
      position: 1,
      name: "Home",
      item: siteConfig.domain,
    },
    {
      "@type": "ListItem",
      position: 2,
      name: pageName,
      item: `${siteConfig.domain}${canonicalPath}`,
    },
  ],
};
---

<Layout title={`${title} | ${siteConfig.businessName}`} description={description}>
  <div class="bg-gray-950 px-4 py-12 md:px-26 lg:px-38">
    <div class="max-w-3xl mx-auto">
      <nav aria-label="Breadcrumb" class="mb-6 text-sm">
        <ol class="flex items-center gap-2 text-gray-400">
          <li>
            <a href="/" class="hover:text-white focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white rounded-sm">
              Home
            </a>
          </li>
          <li aria-hidden="true">/</li>
          <li aria-current="page" class="text-white">{pageName}</li>
        </ol>
      </nav>

      <h1 id="legal-heading" tabindex="-1" class="text-3xl md:text-4xl font-bold text-white">
        {pageName}
      </h1>
      <p class="mt-2 text-sm text-gray-500">Last updated: {updatedDate}</p>

      <!-- No typography plugin assumed — headings/paragraphs/lists inside
           each legal page's slot bring their own utility classes (see
           privacy.astro for the pattern). -->
      <div class="mt-8 space-y-6 text-gray-300 leading-relaxed">
        <slot />
      </div>

      <p class="mt-12 text-sm text-gray-500 border-t border-gray-800 pt-6">
        Questions about this page? <a href={`mailto:${siteConfig.email}`} class="text-red-500 underline underline-offset-2 decoration-red-500/60 hover:text-red-400 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white rounded-sm">Email us</a> or <a href={`tel:${siteConfig.phone}`} class="text-red-500 underline underline-offset-2 decoration-red-500/60 hover:text-red-400 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white rounded-sm">call {siteConfig.phoneDisplay}</a>.
      </p>
    </div>
  </div>

  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
</Layout>