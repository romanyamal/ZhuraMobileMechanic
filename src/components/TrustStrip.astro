<div class="bg-gray-950 border-t border-b border-gray-800 py-4 px-4">
  <div class="max-w-6xl mx-auto flex flex-wrap items-center justify-center gap-6 text-sm text-gray-300">
    <a href={siteConfig.social.google} class="hover:text-white focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-white">
      ★★★★★ Google Reviews
    </a>
    <a href={siteConfig.social.facebook} class="hover:text-white focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-white">
      Find us on Facebook
    </a>
  </div>
</div>