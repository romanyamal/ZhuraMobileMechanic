---
import services from '../data/services.js';

const categories = [...new Set(services.map((service) => service.category))];
---

<section id="services" class="bg-gray-900 px-4 py-20 md:px-26 lg:px-38">
  <div class="text-center mb-16">
    <p class="text-red-500 font-semibold tracking-widest uppercase text-sm mb-2">What We Fix</p>
    <h2 class="text-3xl md:text-4xl font-bold text-white">
      Mobile Mechanic Services in Sacramento
    </h2>
  </div>

  {categories.map((category) => {
    const categoryServices = services.filter((service) => service.category === category);

    return (
      <div class="mb-14 last:mb-0">
        <h3 class="text-xl md:text-2xl font-semibold text-white border-l-4 border-red-600 pl-4 mb-6">
          {category}
        </h3>
        <ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {categoryServices.map((service) => (
            <li class="group relative rounded-lg border border-gray-700 bg-gray-950 p-5 transition-colors hover:border-red-600">
              <h4 class="font-semibold text-lg text-white">{service.name}</h4>
              <p class="mt-2 text-gray-400 group-hover:text-gray-300 transition-colors">
                {service.description}
              </p>
            </li>
          ))}
        </ul>
      </div>
    );
  })}
</section>