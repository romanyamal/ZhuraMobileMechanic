---
import LegalLayout from "../layouts/LegalLayout.astro";
import siteConfig from "../data/site-config.js";

const h2 = "text-xl font-semibold text-white mt-10 mb-3";
const p = "text-gray-300";
const ul = "list-disc pl-6 space-y-1 text-gray-300";
---

<LegalLayout
  title="Terms of Use"
  pageName="Terms of Use"
  description={`Terms of Use for ${siteConfig.businessName}.`}
>
  <div class="rounded-lg border border-amber-800/50 bg-amber-950/30 px-4 py-3 text-sm text-amber-300" role="note">
    <strong>Placeholder content.</strong> This page has the correct structure
    for Terms of Use but the text below is a generic draft — it has not been
    reviewed by an attorney and must not be treated as final before launch.
  </div>

  <p class={p}>
    These Terms of Use govern your use of this website. By using this site,
    you agree to these terms. Please read them carefully.
  </p>

  <h2 class={h2}>Use of This Website</h2>
  <p class={p}>
    This website provides information about {siteConfig.businessName}'s
    mobile mechanic and roadside assistance services and allows visitors to
    request service via a contact form or scheduler. Content is provided for
    general informational purposes and does not constitute a quote or
    guarantee of service availability until confirmed by us directly.
  </p>

  <h2 class={h2}>Booking &amp; Estimates</h2>
  <ul class={ul}>
    <li>Submitting the contact form or scheduler does not guarantee an appointment until confirmed.</li>
    <li>[PLACEHOLDER — cancellation/rescheduling policy, if any.]</li>
    <li>[PLACEHOLDER — diagnostic fee / trip charge policy, if applicable.]</li>
  </ul>

  <h2 class={h2}>Third-Party Tools</h2>
  <p class={p}>
    Scheduling is handled through Cal.com and form submissions through
    Web3Forms; use of those tools is also subject to their respective terms.
  </p>

  <h2 class={h2}>Limitation of Liability</h2>
  <p class={p}>
    [PLACEHOLDER — standard limitation-of-liability language for website use;
    should not be confused with any separate service/repair agreement
    covering actual work performed on a vehicle.]
  </p>

  <h2 class={h2}>Governing Law</h2>
  <p class={p}>[PLACEHOLDER — state governing law, typically California.]</p>

  <h2 class={h2}>Changes to These Terms</h2>
  <p class={p}>
    We may update these terms from time to time. Continued use of the site
    after changes constitutes acceptance of the revised terms.
  </p>

  <h2 class={h2}>Contact Us</h2>
  <p class={p}>
    Questions about these terms can be sent to{" "}
    <a href={`mailto:${siteConfig.email}`} class="text-red-500 underline underline-offset-2 decoration-red-500/60 hover:text-red-400">{siteConfig.email}</a>.
  </p>
</LegalLayout>