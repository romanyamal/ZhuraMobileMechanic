---
// Layout.astro
import '@fontsource-variable/changa'; 
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import siteConfig from '../data/site-config.js';

const base = import.meta.env.BASE_URL;

const {
  title = siteConfig.businessName,
  description = "Mobile mechanic and roadside assistance serving Sacramento and surrounding areas.",
  ogImage = new URL(`${import.meta.env.BASE_URL}og-image.png`, Astro.site || 'https://romanyamal.github.io').toString(),
  // Set true on pages that shouldn't be indexed (404, thank-you pages, etc.)
  noindex = false,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, siteConfig.domain);
---

<!DOCTYPE html>
<html lang="en" class="scroll-smooth scroll-pt-17">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="icon" type="image/x-icon" href={`${base}favicon.ico`} />
    <link rel="icon" type="image/png" sizes="32x32" href={`${base}favicon-32x32.png`} />
    <link rel="icon" type="image/png" sizes="16x16" href={`${base}favicon-16x16.png`} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteConfig.businessName} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <!-- will have to update theme color and manifest details -->
    <meta name="theme-color" content="#dc2626" /> 
    <link rel="apple-touch-icon" sizes="180x180" href={`${base}apple-touch-icon.png`} />
    <meta property="og:locale" content="en_US" />
    <!-- Inside your Layout.astro <head> tags, update the manifest line: -->
    <link rel="manifest" href={`${base}manifest.json`} />

  </head>

  <body>
    <a href="#main-content" class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-50 focus:bg-gray-950 text-white focus:px-4 focus:py-2 focus:rounded focus:shadow-lg">Skip to main content</a>
    <Header />
    <main id="main-content" class="scroll-mt-17">
      <slot />
    </main>
    <Footer />
    <script>
      function jumpToHash(targetId: string, { pushState = true, smooth = true } = {}) {
        const targetSection = document.getElementById(targetId);
        if (!targetSection) return false;

        const heading = targetSection.querySelector('h1, h2, h3, h4, h5, h6') ?? targetSection;
        if (!(heading instanceof HTMLElement)) return false;

        if (pushState) history.pushState(null, '', `#${targetId}`);

        heading.setAttribute('tabindex', '-1');
        
        // Push layout calculation safely into the next animation frame
        requestAnimationFrame(() => {
          targetSection.scrollIntoView({ behavior: smooth ? 'smooth' : 'auto', block: 'start' });
          heading.focus({ preventScroll: true });
        });
        
        return true;
      }

      // Single, consolidated click delegation wrapper for the layout
      document.addEventListener('click', (e) => {
        if (!(e.target instanceof Element)) return;

        // 1. Back to top logic
        const trigger = e.target.closest('[data-scroll-top]');
        if (trigger) {
          e.preventDefault();
          const heading = document.querySelector('main h1');
          window.scrollTo({ top: 0, behavior: 'smooth' });
          if (heading instanceof HTMLElement) {
            heading.setAttribute('tabindex', '-1');
            requestAnimationFrame(() => heading.focus({ preventScroll: true }));
          }
          history.pushState(null, '', location.pathname);
          return;
        }

        // 2. Hash anchors logic
        const link = e.target.closest('a[href^="#"]');
        if (!link) return;

        const targetId = link.getAttribute('href')?.slice(1);
        if (!targetId) return;

        if (jumpToHash(targetId)) e.preventDefault();
      });

      // Handle external page deep links safely when CPU is idle
      // Let the browser paint everything and go completely idle before touching focus/scrolling
      if (location.hash) {
        const handleHashArrival = () => {
          setTimeout(() => {
            // Check if browser is idle before invoking layout updates
            if (window.requestIdleCallback) {
              window.requestIdleCallback(() => {
                jumpToHash(location.hash.slice(1), { pushState: false, smooth: false });
              });
            } else {
              setTimeout(() => {
                jumpToHash(location.hash.slice(1), { pushState: false, smooth: false });
              }, 100);
            }
          }, 50);
        };

        if (document.readyState === 'complete') {
          handleHashArrival();
        } else {
          window.addEventListener('load', handleHashArrival, { once: true });
        }
      }
    </script>
  </body>
</html>