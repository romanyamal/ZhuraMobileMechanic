---
import Nav from '../data/nav.js'
import siteConfig from '../data/site-config'

const base = import.meta.env.BASE_URL;
const currentPath = Astro.url.pathname;
// The nav/logo/Book Now links are in-page hash anchors that only resolve
// on the single scrolling home page. On the separate legal/404 routes
// there's no matching section to jump to, so route home first and let the
// hash resolve there (Layout.astro's script handles the focus-on-arrival
// behavior once "/" has loaded).
const isHome = currentPath === base || currentPath === `${base}index.html`;
const toHref = (hash: string) => (isHome ? hash : `${base}${hash}`);
// NOTE: assumes the Hero section's id is "home" (per build spec §5.1's
// suggested `href="#home"` for the logo). Update this constant if Hero.astro
// uses a different id.
const logoHref = isHome ? "#home" : base;
---
<header class="site-header fixed top-0 left-0 w-full transform-gpu tranzlate-z-0 z-40 bg-gray-950 text-gray-300 shadow-sm">
  <div class="relative mx-auto flex max-w-6xl items-center justify-between px-7 py-5">
    
    <div class="logo">
      <a href={logoHref} class="text-lg font-bold">{siteConfig.shortName}</a>
    </div>

    <button 
      id="menu-btn" 
      aria-expanded="false" 
      aria-controls="nav-menu" 
      aria-label="Open menu"
      class="group md:hidden flex flex-col justify-center items-center w-7 h-7 gap-1.5 cursor-pointer">
      <span class="w-6 h-0.5 bg-gray-300 transition-all duration-300 transform origin-center group-[.is-open]:rotate-45 group-[.is-open]:translate-y-2"></span>
      <span class="w-6 h-0.5 bg-gray-300 transition-all duration-300 group-[.is-open]:opacity-0"></span>
      <span class="w-6 h-0.5 bg-gray-300 transition-all duration-300 transform origin-center group-[.is-open]:-rotate-45 group-[.is-open]:-translate-y-2"></span>
    </button>

    <nav id="nav-menu" aria-label="Primary" class="hidden md:block absolute md:static top-full left-0 w-full md:w-auto bg-gray-900 md:bg-transparent shadow-md md:shadow-none transition-all duration-200">
      <ul class="flex flex-col text-md text-center md:flex-row items-center gap-6 md:gap-4 lg:gap-6 px-8 py-4 md:p-0 md:h-7">
        {Nav.map((nav) => (
          <li class="w-full md:w-auto">
            <a href={toHref(nav.href)} class="block py-2 md:py-0 hover:underline hover:text-white">{nav.label}</a>
          </li>
        ))}
         <li class="w-full md:w-auto flex justify-center md:my-2.5">
          <a 
            href={toHref('#scheduler')} 
            class="block text-center bg-red-600 text-white rounded-lg font-semibold hover:bg-red-800 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-white transition-colors w-[95%] text-xl py-3 md:w-auto md:text-sm md:py-2 px-4 lg:text-base">Book Now</a>
         </li>
      </ul>
    </nav>

  </div>
</header>


<script>
  const toggle = document.getElementById('menu-btn');
  const menu = document.getElementById('nav-menu');

  if (toggle && menu) {
    const closeMenu = () => {
      toggle.setAttribute('aria-expanded', 'false');
      toggle.setAttribute('aria-label', 'Open menu');
      toggle.classList.remove('is-open');
      menu.classList.add('hidden');
      menu.classList.remove('block');
    };

    const openMenu = () => {
      toggle.setAttribute('aria-expanded', 'true');
      toggle.setAttribute('aria-label', 'Close menu');
      toggle.classList.add('is-open');
      menu.classList.remove('hidden');
      menu.classList.add('block');
    };

    toggle.addEventListener('click', () => {
      const isOpen = toggle.getAttribute('aria-expanded') === 'true';
      isOpen ? closeMenu() : openMenu();
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') {
        closeMenu();
        toggle.focus();
      }
    });

    document.addEventListener('click', (e) => {
    if (!(e.target instanceof Element)) return;

    const isOpen = toggle.getAttribute('aria-expanded') === 'true';
    const clickedInsideMenu = menu.contains(e.target);
    const clickedToggle = toggle.contains(e.target);
    const clickedNavitem = e.target.closest('a');

    if (isOpen && ((!clickedInsideMenu && !clickedToggle) || (clickedInsideMenu && clickedNavitem))) {
        closeMenu();
    }
    });
  }
</script>