---
import siteConfig from "../data/site-config.js";
import nav from "../data/nav.js";
import services from "../data/services.js";
import serviceAreas from "../data/service-areas.js";

const base = import.meta.env.BASE_URL;
const currentPath = Astro.url.pathname;

const year = new Date().getFullYear();

const isHome = currentPath === base || currentPath === `${base}index.html`;
const toHref = (hash: string) => (isHome ? hash : `${base}${hash}`);
const logoHref = isHome ? "#home" : base;

const linkClasses =
  "text-gray-400 hover:text-white focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white rounded-sm transition-colors";
const headingClasses = "text-sm font-semibold text-white tracking-wide uppercase mb-4";

// 1. Explicitly map your days union type
type DayOfWeek = "monday" | "tuesday" | "wednesday" | "thursday" | "friday" | "saturday" | "sunday";

interface HoursGroup {
  start: DayOfWeek;
  end: DayOfWeek;
  display: string;
}

const DAY_ORDER: DayOfWeek[] = ["monday", "tuesday", "wednesday", "thursday", "friday", "saturday", "sunday"];

const DAY_LABEL: Record<DayOfWeek, string> = { 
  monday: "Mon", tuesday: "Tue", wednesday: "Wed", thursday: "Thu", friday: "Fri", saturday: "Sat", sunday: "Sun" 
};

// FIX 1: Enforce Record validation on DAY_SCHEMA so it maps seamlessly to your loop keys
const DAY_SCHEMA: Record<DayOfWeek, string> = { 
  monday: "Monday", tuesday: "Tuesday", wednesday: "Wednesday", thursday: "Thursday", friday: "Friday", saturday: "Saturday", sunday: "Sunday" 
};

// FIX 2: Safely cast siteConfig.hours to prevent implicit 'any' bugs downstream
const siteHours = siteConfig.hours as Record<DayOfWeek, string>;

function to12Hour(time24: string) {
  const [h, m] = time24.split(":").map(Number);
  const period = h >= 12 ? "PM" : "AM";
  const hour12 = h % 12 === 0 ? 12 : h % 12;
  return `${hour12}:${String(m).padStart(2, "0")} ${period}`;
}

function formatRangeDisplay(range: string) {
  if (range === "closed") return "Closed";
  const [opens, closes] = range.split("–");
  return `${to12Hour(opens)}–${to12Hour(closes)}`;
}

const hoursGroups: HoursGroup[] = [];
for (const day of DAY_ORDER) {
  // Use the typed siteHours reference here
  const display = formatRangeDisplay(siteHours[day]);
  const last = hoursGroups[hoursGroups.length - 1];
  
  if (last && last.display === display) {
    last.end = day;
  } else {
    hoursGroups.push({ start: day, end: day, display });
  }
}

const hoursDisplayLines = hoursGroups.map((g) =>
  g.start === g.end
    ? `${DAY_LABEL[g.start]}: ${g.display}`
    : `${DAY_LABEL[g.start]}–${DAY_LABEL[g.end]}: ${g.display}`
);

// schema.org openingHoursSpecification — now compiles with no implicit typing complaints
const openingHoursSpecification = DAY_ORDER.filter((day) => siteHours[day] !== "closed").map(
  (day) => {
    const [opens, closes] = siteHours[day].split("–");
    return {
      "@type": "OpeningHoursSpecification",
      dayOfWeek: DAY_SCHEMA[day],
      opens,
      closes,
    };
  }
);

const serviceCategories = [...new Set(services.map((s) => s.category))];
const primaryCities = serviceAreas.filter((a) => a.tier === "primary").map((a) => a.city);

const hasAddress = Object.keys(siteConfig.address ?? {}).length > 0;

const businessSchema = {
  "@context": "https://schema.org",
  "@type": "AutoRepair",
  name: siteConfig.businessName,
  image: `${siteConfig.domain}/images/og-share-default.jpg`,
  telephone: siteConfig.phone,
  email: siteConfig.email,
  url: siteConfig.domain,
  ...(hasAddress
    ? {
        address: {
          "@type": "PostalAddress",
          ...siteConfig.address,
        },
      }
    : {}),
  areaServed: primaryCities.map((city) => ({ "@type": "City", name: city })),
  openingHoursSpecification,
  sameAs: [siteConfig.social.google, siteConfig.social.facebook].filter(Boolean),
  priceRange: siteConfig.priceRange,
};
---

<footer class="bg-black border-t border-gray-800">
  <div class="px-4 py-16 md:px-26 lg:px-38">
    <div class="grid grid-cols-1 gap-10 sm:grid-cols-2 lg:grid-cols-4">
      <!-- 1. Brand + social -->
      <div>
        <a
          href={logoHref}
          class="inline-block text-lg font-bold text-white focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white rounded-sm"
        >
          {siteConfig.businessName}
        </a>
        <p class="mt-2 text-sm text-gray-400">{siteConfig.tagline}</p>

        <div class="mt-5 flex items-center gap-4">
          <a
            href={siteConfig.social.google}
            class={linkClasses}
            aria-label={`${siteConfig.shortName} on Google (reviews)`}
            target="_blank"
            rel="noopener noreferrer"
          >
            <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M11.48 3.499a.562.562 0 011.04 0l2.125 5.111a.563.563 0 00.475.345l5.518.442c.499.04.701.663.321.988l-4.204 3.602a.563.563 0 00-.182.557l1.285 5.385a.562.562 0 01-.84.61l-4.725-2.885a.563.563 0 00-.586 0L6.982 20.94a.562.562 0 01-.84-.61l1.285-5.386a.563.563 0 00-.182-.557l-4.204-3.602a.563.563 0 01.321-.988l5.518-.442a.563.563 0 00.475-.345L11.48 3.5z" />
            </svg>
          </a>
          <a
            href={siteConfig.social.facebook}
            class={linkClasses}
            aria-label={`${siteConfig.shortName} on Facebook`}
            target="_blank"
            rel="noopener noreferrer"
          >
            <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M14 9.5h2.5V6.5H14c-1.933 0-3.5 1.567-3.5 3.5v2H8v3h2.5v7H14v-7h2.25l.5-3H14v-1.5c0-.5.25-1 .75-1z" />
            </svg>
          </a>
        </div>
      </div>

      <!-- 2. Contact block -->
      <div>
        <h2 class={headingClasses}>Contact</h2>
        <ul class="space-y-2 text-sm">
          <li>
            <a href={`tel:${siteConfig.phone}`} class={linkClasses}>{siteConfig.phoneDisplay}</a>
          </li>
          <li>
            <a href={`mailto:${siteConfig.email}`} class={linkClasses}>{siteConfig.email}</a>
          </li>
        </ul>
        <h3 class="mt-5 text-xs font-semibold text-white uppercase tracking-wide">Hours</h3>
        <ul class="mt-2 space-y-1 text-sm text-gray-400">
          {hoursDisplayLines.map((line) => <li>{line}</li>)}
        </ul>
      </div>

      <!-- 3 & 4. Condensed service area + services lists -->
      <div>
        <h2 class={headingClasses}>
          <a href={toHref("#service-area")} class="hover:text-red-500 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white rounded-sm">
            Service Area
          </a>
        </h2>
        <ul class="space-y-1.5 text-sm text-gray-400">
          {primaryCities.map((city) => <li>{city}</li>)}
        </ul>
        <p class="mt-3 text-xs text-gray-400">
          Don't see your city? <a href={`tel:${siteConfig.phone}`} class="text-white underline hover:text-red-500 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white rounded-sm transition-colors">Call</a> or <a href={`sms:${siteConfig.phone}`} class="text-white underline hover:text-red-500 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white rounded-sm transition-colors">text</a> us — we may still be able to help.
        </p>

        <h2 class={`${headingClasses} mt-6`}>
          <a href={toHref("#services")} class="hover:text-red-500 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white rounded-sm">
            Services
          </a>
        </h2>
        <ul class="space-y-1.5 text-sm text-gray-400">
          {serviceCategories.map((category) => <li>{category}</li>)}
        </ul>
      </div>

      <!-- 8. Site section list (secondary nav / sitemap) -->
      <div>
        <h2 class={headingClasses}>Site Map</h2>
        <ul class="space-y-1.5 text-sm">
          {nav.map((item) => (
            <li>
              <a href={toHref(item.href)} class={linkClasses}>{item.label}</a>
            </li>
          ))}
          <li>
            <button type="button" data-scroll-top class={`${linkClasses} cursor-pointer`}>
              Back to top ↑
            </button>
          </li>
        </ul>
      </div>
    </div>

    <!-- 6 & 7. License/insurance + payment methods -->
    <div class="mt-12 pt-8 border-t border-gray-900 flex flex-col gap-3 text-xs text-gray-400 sm:flex-row sm:items-start sm:justify-between">
      <div class="space-y-1">
        <p>License {siteConfig.license} · Auto Repair Dealer {siteConfig.ard}</p>
        <p>{siteConfig.insuranceDisclosure}</p>
      </div>
      {siteConfig.paymentMethods?.length > 0 && (
        <div>
          <p>
            <span class="text-gray-400">Payment accepted:</span>{" "}
            {siteConfig.paymentMethods.join(", ")}
          </p>
        </div>
      )}
    </div>

    <!-- 9 & 10. Legal links + copyright -->
    <div class="mt-8 pt-8 border-t border-gray-900 flex flex-col gap-4 text-sm sm:flex-row sm:items-center sm:justify-between">
      <ul class="flex flex-wrap gap-x-6 gap-y-2">
        <li><a href={`${base}privacy`} class={linkClasses}>Privacy Policy</a></li>
        <li><a href={`${base}terms`} class={linkClasses}>Terms of Use</a></li>
        <li><a href={`${base}accessibility`} class={linkClasses}>Accessibility Statement</a></li>
      </ul>
      <p class="text-gray-400">&copy; {year} {siteConfig.businessName}. All rights reserved.</p>
    </div>
  </div>

  <script type="application/ld+json" set:html={JSON.stringify(businessSchema)} />
</footer>