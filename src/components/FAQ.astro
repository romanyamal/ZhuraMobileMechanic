---
import faqs from '../data/faq.js';
---

<section id="faq" class="bg-gray-900 px-4 py-20 md:px-26 lg:px-38">
  <div class="max-w-5xl mx-auto">
    <div class="text-center mb-16">
      <p class="text-red-500 font-semibold tracking-widest uppercase text-sm mb-2">Questions</p>
      <h2 class="text-3xl md:text-4xl font-bold text-white">
        Frequently Asked Questions
      </h2>
    </div>

    <div class="grid md:grid-cols-2 gap-x-8 gap-y-4">
      {faqs.map((faq, index) => (
        <details class="group border border-gray-800 rounded-lg px-5 py-4 open:border-red-600 h-fit">
          <summary class="flex items-start gap-4 cursor-pointer text-white font-semibold list-none focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-white">
            <span class="text-2xl font-bold text-blue-400 group-open:text-red-600 leading-none pt-0.5 shrink-0 transition-colors">
              {String(index + 1).padStart(2, '0')}
            </span>
            <span class="flex-1">{faq.question}</span>
            <svg
              class="w-5 h-5 text-red-500 shrink-0 transition-transform group-open:rotate-45 mt-0.5"
              fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true"
            >
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
            </svg>
          </summary>
          <p class="mt-3 text-gray-300 leading-relaxed pl-10">{faq.answer}</p>
        </details>
      ))}
    </div>
  </div>
</section>