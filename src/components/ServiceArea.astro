---
import serviceAreas from '../data/service-areas.js';

const primaryCities = serviceAreas.filter((area) => area.tier === 'primary');
const secondaryCities = serviceAreas.filter((area) => area.tier === 'secondary');
---

<section id="service-area" class="bg-gray-950 px-4 py-20 md:px-26 lg:px-38">
  <div class="max-w-6xl mx-auto">
    <div class="text-center mb-16">
      <p class="text-red-500 font-semibold tracking-widest uppercase text-sm mb-2">Where We Work</p>
      <h2 class="text-3xl md:text-4xl font-bold text-white">
        Serving Sacramento & Surrounding Areas
      </h2>
    </div>

    <img
      src="./src/assets/service-area-map.png"
      alt="Map of Zhura Mobile Mechanic's service radius across the greater Sacramento area"
      width="1000"
      height="500"
      loading="lazy"
      class="w-full h-auto rounded-lg mb-16"
    />

    <div>
      <h3 class="text-xl font-semibold text-white mb-6">Primary Service Cities</h3>
      <div class="grid gap-x-8 gap-y-8 sm:grid-cols-2 lg:grid-cols-3 mb-14">
        {primaryCities.map((area) => (
          <div>
            <h4 class="font-semibold text-white text-lg mb-2">{area.city}</h4>
            <ul class="flex flex-wrap gap-x-2 gap-y-1 text-sm text-gray-400">
              {area.neighborhoods.map((neighborhood, i) => (
                <li>
                  {neighborhood}{i < area.neighborhoods.length - 1 && <span class="text-gray-600">,</span>}
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>

      <h3 class="text-xl font-semibold text-white mb-6 border-t border-gray-800 pt-10">
        Also Serving
      </h3>
      <div class="grid gap-x-8 gap-y-8 sm:grid-cols-2 lg:grid-cols-3">
        {secondaryCities.map((area) => (
          <div>
            <h4 class="font-semibold text-gray-200 mb-2">{area.city}</h4>
            <ul class="flex flex-wrap gap-x-2 gap-y-1 text-sm text-gray-200">
              {area.neighborhoods.map((neighborhood, i) => (
                <li>
                  {neighborhood}{i < area.neighborhoods.length - 1 && <span class="text-gray-600">,</span>}
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>